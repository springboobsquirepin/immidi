.Instrument Definitions


[Roland GR-1 (SR) Guitar Module]
BankSelMethod=1
Control=Roland GR-1
Patch[*]=Roland GR-1 Patches
Key[*,52]=Roland GR-1 Drums
Drum[*,52]=1

[Roland GR-1 (SR) Multi Module]
BankSelMethod=1
Control=Roland GR-1
Patch[0]=Roland GR-1 Tone Bank 1
Patch[1]=Roland GR-1 Tone Bank 2
Patch[2]=Roland GR-1 Tone Bank 3
Patch[3]=Roland GR-1 Tone Bank 4

[Roland GR-1 (SR) Drumset]
