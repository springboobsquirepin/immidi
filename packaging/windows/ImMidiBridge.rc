// Windows resources for ImMidiBridge.exe: the icon and the version information shown in Explorer
// (Properties > Details). The version matches immidiVersion in premake5.lua.
#include <winver.h>

// GLFW uses the icon named GLFW_ICON for its windows (title bar, taskbar); Explorer shows the
// executable's first icon, which is this one as well.
GLFW_ICON ICON "ImMidiBridge.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "ImMidi Bridge MIDI converter"
            VALUE "FileVersion", "1.0"
            VALUE "InternalName", "ImMidiBridge"
            VALUE "OriginalFilename", "ImMidiBridge.exe"
            VALUE "ProductName", "ImMidi"
            VALUE "ProductVersion", "1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
